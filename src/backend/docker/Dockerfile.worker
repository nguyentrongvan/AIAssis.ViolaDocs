# Dockerfile for OCR Worker Service
FROM python:3.10-slim

# Install system dependencies including Tesseract OCR and build tools
RUN apt-get update && apt-get install -y \
    # Build dependencies (required for PyMuPDF and other packages)
    build-essential \
    python3-dev \
    swig \
    # Tesseract OCR and language data
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-vie \
    tesseract-ocr-jpn \
    tesseract-ocr-kor \
    tesseract-ocr-chi-sim \
    tesseract-ocr-fra \
    tesseract-ocr-deu \
    tesseract-ocr-spa \
    # Image processing libraries
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    libopenjp2-7-dev \
    # PDF processing
    poppler-utils \
    # Cleanup
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Upgrade pip, setuptools and wheel first (required for building wheels)
RUN pip install --upgrade pip setuptools wheel

# Install PyTorch CPU version first from PyTorch index (pre-built wheels, much faster)
# This avoids building torch from source which takes a very long time
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchvision torchaudio

# Install PyMuPDF separately with version compatible with paddleocr (<1.21.0)
# Try to use pre-built wheels first, fallback to prefer-binary
RUN pip install --no-cache-dir --only-binary :all: "PyMuPDF<1.21.0" || \
    pip install --no-cache-dir --prefer-binary "PyMuPDF<1.21.0"

# Copy requirements first for better caching
COPY requirements-ocr.txt .

# Install Python dependencies (torch and PyMuPDF already installed, so pip will skip them)
RUN pip install --no-cache-dir -r requirements-ocr.txt

# Copy application code
COPY src/ ./src/
COPY alembic.ini .
COPY migrations/ ./migrations/
COPY docker/worker_entrypoint.sh ./
RUN chmod +x worker_entrypoint.sh

# Set Python path
ENV PYTHONPATH=/app/src

# Default environment variables
ENV OCR_WORKER_POLL_INTERVAL=2
ENV OCR_WORKER_MAX_CONCURRENT=2
ENV OCR_WORKER_HEARTBEAT_INTERVAL=30
ENV OCR_WORKER_STUCK_TIMEOUT=10

# Run migrations and start worker
CMD ["./worker_entrypoint.sh"]

