# Database
# Use 'postgres' for Docker, 'localhost' for local development
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=viadocs
POSTGRES_PASSWORD=viadocs_pass
POSTGRES_DB=viadocs_db

# MinIO
# Use 'minio:9000' for Docker, 'localhost:9000' for local development
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET=documents

# Redis
# Use 'redis' for Docker, 'localhost' for local development
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Root User - Auto-created on startup if not exists
ROOT_USER_EMAIL=admin@example.com
ROOT_USER_PASSWORD=admin123
ROOT_USER_NAME=Admin

# Qdrant Vector Database
# Use 'qdrant' for Docker, 'localhost' for local development
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=embeddings
QDRANT_API_KEY=

# Ollama - Local LLM with OpenAI-compatible API
# Base URL for Ollama server (use http://ollama:11434 in docker, http://localhost:11434 for local)
OLLAMA_BASE_URL=http://ollama:11434
# Optional API key for OpenAI-compatible endpoints (usually not needed for local Ollama)
OLLAMA_API_KEY=
# LLM model name for chat (e.g., llama3.2, mistral, qwen2.5:0.5b)
OLLAMA_LLM_MODEL=qwen2.5:0.5b
# Embedding model name (default: nomic-embed-text:latest)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# OCR
# Only Tesseract is supported
# Note: Tesseract requires system installation (apt-get install tesseract-ocr tesseract-ocr-vie on Linux)
# Supported languages: en (English), vi (Vietnamese), ja (Japanese), ko (Korean), zh (Chinese)
OCR_PROVIDER=tesseract
OCR_LANGUAGES=en,vi

# App Settings
API_V1_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO

# Retention & Purge
DEFAULT_RETENTION_DAYS=365
PURGE_GRACE_PERIOD_DAYS=30

# File Upload
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,image/tiff,text/csv,application/csv,text/plain

# Worker Configuration (AI Jobs Processing)
# Enable in-process worker (default: false - use separate OCR worker service)
ENABLE_IN_PROCESS_WORKER=false
# Max concurrent OCR jobs (default: 5)
MAX_CONCURRENT_OCR_JOBS=5
# OCR Worker Service Configuration (for standalone workers)
OCR_WORKER_POLL_INTERVAL=2
OCR_WORKER_MAX_CONCURRENT=2
OCR_WORKER_HEARTBEAT_INTERVAL=30
OCR_WORKER_STUCK_TIMEOUT=10
# Max concurrent embedding jobs (default: 3)
MAX_CONCURRENT_EMBED_JOBS=3
# Number of jobs to fetch per iteration (default: 10)
WORKER_BATCH_SIZE=10

# Purge Worker Configuration
PURGE_WORKER_POLL_INTERVAL=3600
PURGE_WORKER_BATCH_SIZE=100
PURGE_WORKER_DRY_RUN=false

