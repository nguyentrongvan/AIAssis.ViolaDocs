# ============================================
# ViolaDocs Platform Configuration
# ============================================
# Copy this file to .env and customize for your environment
# cp .env.example .env

# ============================================
# Domain & SSL Configuration
# ============================================
DOMAIN=localhost
ENABLE_SSL=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
LETSENCRYPT_EMAIL=

# ============================================
# Backend API Configuration
# ============================================
API_BASE_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost

# ============================================
# Database Configuration
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=viadocs
POSTGRES_PASSWORD=viadocs_pass
POSTGRES_DB=viadocs_db

# ============================================
# MinIO Object Storage Configuration
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET=documents

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================
# Qdrant Vector Database Configuration
# ============================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=embeddings
QDRANT_API_KEY=

# ============================================
# Ollama LLM Configuration
# ============================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_API_KEY=
OLLAMA_LLM_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# ============================================
# JWT Authentication Configuration
# ============================================
JWT_SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars-long-please-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Root User Configuration
# ============================================
ROOT_USER_EMAIL=admin@example.com
ROOT_USER_PASSWORD=admin123
ROOT_USER_NAME=Admin

# ============================================
# OCR Configuration
# ============================================
OCR_PROVIDER=paddle
OCR_LANGUAGES=en,vi

# ============================================
# Application Settings
# ============================================
API_V1_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# Retention & Purge Configuration
# ============================================
DEFAULT_RETENTION_DAYS=365
PURGE_GRACE_PERIOD_DAYS=30

# ============================================
# File Upload Configuration
# ============================================
MAX_UPLOAD_SIZE_MB=100
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,image/tiff,text/csv,application/csv,text/plain

# ============================================
# Worker Configuration
# ============================================
ENABLE_IN_PROCESS_WORKER=false
MAX_CONCURRENT_OCR_JOBS=5
OCR_WORKER_POLL_INTERVAL=2
OCR_WORKER_MAX_CONCURRENT=2
OCR_WORKER_HEARTBEAT_INTERVAL=30
OCR_WORKER_STUCK_TIMEOUT=10
MAX_CONCURRENT_EMBED_JOBS=3
WORKER_BATCH_SIZE=10
PURGE_WORKER_POLL_INTERVAL=3600
PURGE_WORKER_BATCH_SIZE=100
PURGE_WORKER_DRY_RUN=false

# ============================================
# Frontend Build Configuration
# ============================================
VITE_API_BASE=/api/v1
